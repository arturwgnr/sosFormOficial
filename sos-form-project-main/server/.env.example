# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (ver .gitignore).

# --- Banco de dados ---
# Deve bater com as credenciais do docker-compose.yml (ou com o Postgres
# que voce estiver usando).
DATABASE_URL="postgresql://sos_user:sos_password@localhost:5434/sos_transp?schema=public"

# --- Servidor ---
PORT=4000
NODE_ENV=development

# Origem do frontend (Vite dev server), usada no CORS. Precisa bater
# exatamente (protocolo + host + porta) para o cookie de sessao funcionar.
CORS_ORIGIN="http://localhost:5173"

# --- Sessao ---
SESSION_COOKIE_NAME=sos_session
SESSION_TTL_DAYS=7

# --- Limite de tentativas de login ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Seed dos 3 administradores (nunca criados pela tela) ---
ADMIN_1_NAME="Admin Um"
ADMIN_1_EMAIL="admin1@sostranspaletes.com.br"
ADMIN_1_PASSWORD="trocar-esta-senha-1"

ADMIN_2_NAME="Admin Dois"
ADMIN_2_EMAIL="admin2@sostranspaletes.com.br"
ADMIN_2_PASSWORD="trocar-esta-senha-2"

ADMIN_3_NAME="Admin Tres"
ADMIN_3_EMAIL="admin3@sostranspaletes.com.br"
ADMIN_3_PASSWORD="trocar-esta-senha-3"
