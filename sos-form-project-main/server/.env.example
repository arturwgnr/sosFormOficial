# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (ver .gitignore).

# --- Banco de dados ---
# Deve bater com as credenciais do docker-compose.yml (ou com o Postgres
# que voce estiver usando).
DATABASE_URL="postgresql://sos_user:sos_password@localhost:5434/sos_transp?schema=public"

# --- Servidor ---
PORT=4000
NODE_ENV=development

# Origem do frontend, usada no CORS. Precisa bater exatamente
# (protocolo + host + porta) para o cookie de sessao funcionar.
# Local:      http://localhost:5173
# Producao:   https://sistema.sostranspaletes.com.br
CORS_ORIGIN="http://localhost:5173"

# --- Sessao ---
SESSION_COOKIE_NAME=sos_session
SESSION_TTL_DAYS=7

# So preencher em producao (frontend e backend em subdominios do mesmo
# dominio): permite o cookie circular entre sistema.* e api.*. Note o
# ponto no inicio. Deixar vazio/comentado em desenvolvimento local.
# COOKIE_DOMAIN=.sostranspaletes.com.br

# --- Limite de tentativas de login ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Senha de acoes administrativas (remover usuario etc.) ---
# Guardar SO o hash bcrypt, nunca a senha em texto. Gerar com:
#   npm run hash:password -- "sua-senha-aqui"
# Use aspas SIMPLES: o hash contem "$". O valor abaixo e so um
# exemplo do formato (nao e um hash valido), troque antes de usar.
# Sem esta variavel, as acoes administrativas ficam desativadas.
# Usa o mesmo limite de tentativas do login (variaveis acima).
ADMIN_ACTIONS_PASSWORD_HASH='$2a$12$exemploExemploExemploExemploExemploExemploExemploExem'

# --- Seed dos administradores (nunca criados pela tela) ---
# Numerados em sequencia (ADMIN_1, ADMIN_2, ...), sem pular numero.
# So estes e-mails ficam como ADMIN: `npm run admins:cleanup` remove
# qualquer outro usuario com papel ADMIN (relatorios sao mantidos).
ADMIN_1_NAME="Admin Um"
ADMIN_1_EMAIL="admin1@sostranspaletes.com.br"
ADMIN_1_PASSWORD="trocar-esta-senha-1"

ADMIN_2_NAME="Admin Dois"
ADMIN_2_EMAIL="admin2@sostranspaletes.com.br"
ADMIN_2_PASSWORD="trocar-esta-senha-2"

ADMIN_3_NAME="Admin Tres"
ADMIN_3_EMAIL="admin3@sostranspaletes.com.br"
ADMIN_3_PASSWORD="trocar-esta-senha-3"

ADMIN_4_NAME="Admin Quatro"
ADMIN_4_EMAIL="admin4@sostranspaletes.com.br"
ADMIN_4_PASSWORD="trocar-esta-senha-4"
